# Copy this file to .env (which git ignores) and adjust if needed.
# Values match docker-compose.yml.

NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=pulseops
DB_PASSWORD=pulseops
DB_NAME=pulseops

# Redis (used from Step 3 onward)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka / Redpanda (used from Step 3 onward). Comma-separated list.
KAFKA_BROKERS=localhost:19092
